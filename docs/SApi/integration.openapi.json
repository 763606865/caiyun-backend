  "components": {
    "securitySchemes": {
      "AppKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-App-Key"
      },
      "Timestamp": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Timestamp"
      },
      "Nonce": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Nonce"
      },
      "Signature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Signature"
      },
      "Bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Identity": {
        "type": "object",
        "required": [
          "user_uuid",
          "enterprise_uuid",
          "employment_uuid",
          "application_code"
        ],
        "properties": {
          "user_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "enterprise_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "employment_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "application_code": {
            "type": "string"
          }
        }
      },
      "AuthorizationResult": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Identity"
          },
          {
            "type": "object",
            "properties": {
              "active": {
                "type": "boolean"
              },
              "version": {
                "type": "integer"
              },
              "reason": {
                "type": "string"
              },
              "valid_until": {
                "type": "string",
                "format": "date-time"
              },
              "state": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
