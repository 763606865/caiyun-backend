          "409": {
            "description": "幂等/版本冲突或快照过期"
          },
          "422": {
            "description": "字段校验失败"
          }
        },
        "parameters": [
          {
            "name": "enterprise_uuid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
