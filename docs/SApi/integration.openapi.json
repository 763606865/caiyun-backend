  "paths": {
    "/sapi/directory/upserts": {
      "post": {
        "summary": "幂等来源目录写入；payload白名单见配套文档",
        "security": [
          {
            "AppKey": [],
            "Timestamp": [],
            "Nonce": [],
            "Signature": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功；code/data/meta外层",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "object",
                      "required": [],
                      "properties": {
                        "entity_uuid": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "enterprise_uuid": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "entity_type": {
                          "type": "string"
                        },
                        "version": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "source_version": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "凭证或票据无效"
          },
          "403": {
            "description": "无应用或企业授权"
          },
          "404": {
            "description": "对象不存在或不可见"
          },
          "409": {
            "description": "幂等/版本冲突或快照过期"
          },
          "422": {
            "description": "字段校验失败"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "entity_type",
                  "source_system",
                  "source_id",
                  "source_version",
                  "idempotency_key",
                  "payload"
                ],
                "properties": {
                  "entity_type": {
                    "type": "string",
                    "enum": [
                      "enterprise",
                      "user",
                      "organization",
                      "employment"
                    ]
                  },
                  "source_system": {
                    "type": "string"
                  },
                  "source_id": {
                    "type": "string"
                  },
                  "source_version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "enterprise_uuid": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true
                  },
                  "entity_uuid": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true
                  },
                  "idempotency_key": {
                    "type": "string"
                  },
                  "payload": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sapi/directory/snapshots": {
      "get": {
        "summary": "按企业/类型一致快照，100条每页，30分钟有效",
